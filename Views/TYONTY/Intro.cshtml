<script>
    // Function to hide all secondImages initially
    function hideSecondImages() {
        const secondImages = document.querySelectorAll('.secondImages');
        secondImages.forEach(image => {
            image.style.display = 'none';
        });
    }

    // Function to change the message after a delay
    function changeMessage(message, delay) {
        setTimeout(function () {
            $('#message').text(message);
        }, delay);
    }

    // Function to hide/show images after the message
    function toggleImages(delay) {
        setTimeout(function () {
            const firstImages = document.querySelectorAll('.firstImages');
            const secondImages = document.querySelectorAll('.secondImages');

            firstImages.forEach(image => {
                image.style.display = 'none';
            });

            secondImages.forEach(image => {
                image.style.display = 'block';
            });
        }, delay);
    }

    // Initial sequence
    hideSecondImages(); // Hide secondImages initially
    changeMessage("Hello, my name is Joel Myhrr.", 0);
    changeMessage("Welcome to Thank You or No Thank You!", 5000);
    changeMessage("Here we have 26 dogs", 10000);
    changeMessage("With prizes ranging from a dollar to a brand new Lamborghini!", 15000);
    changeMessage("You will pick a dog and at the end...", 20000);
    changeMessage("You can take the dog and the prize home.", 25000);
    changeMessage("However!", 30000);
    changeMessage("The Dog Catcher will try to buy your dog & prize for as little as possible.", 35000);
    changeMessage("In order to find out what your dog has...", 40000);
    changeMessage("We'll have to see what your dog doesn't have.", 45000);
    changeMessage("But first...", 50000);
    toggleImages(55000); // Display secondImages
    changeMessage("Pick a dog", 56000); // Add your message delay here
</script>