<div class="text-center mt-5">
<img class="doggie" id="dogImage" src="">
<h4>You picked: @Context.Session.GetString("yourDog")</h4>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
    const dogName = '@Context.Session.GetString("yourDog")';
    const dogImageElement = document.getElementById('dogImage');
    
    // Assuming images are stored in the /img/ directory and are named based on dogName
    const imagePath = `/img/${dogName}.png`;
    
    // Set the src attribute of the image element
    dogImageElement.src = imagePath;

    // Initially hide the elements
    document.getElementById('showOffer').style.display = 'none';
    document.getElementById('thanksOrNoThanks').style.display = 'none';

    function changeMessage(message, delay) {
        setTimeout(function() {
            const messageElement = document.getElementById('message');
            messageElement.textContent = message;
        }, delay);
    }

    function showOfferAndButtons() {
        document.getElementById('showOffer').style.display = 'block';
        changeMessage('Now the question is...', 0);
        setTimeout(function() {
            document.getElementById('thanksOrNoThanks').style.display = 'block';
        }, 10000);
    }

    changeMessage('At any moment,', 0);
    changeMessage('The Dog Catcher should be calling.', 3000);
    changeMessage('*ring!*', 6000);
    changeMessage('', 6500);
    changeMessage('*ring!*', 7000);
    changeMessage('', 7500);
    changeMessage('That must be him.', 8000);
    changeMessage('Hello?', 9000);
    changeMessage('I see...', 14000);
    changeMessage('OK...', 19000);
    changeMessage('', 24000);
    changeMessage('The offer is...', 27000);
    setTimeout(showOfferAndButtons, 32000);
});
</script>
