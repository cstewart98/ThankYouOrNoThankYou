<div class="text-center mt-5">
<img class="doggie" id="dogImage" src="">
<h4>You picked: @Context.Session.GetString("yourDog")</h4>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const dogName = '@Context.Session.GetString("yourDog")';
        const dogImageElement = document.getElementById('dogImage');
        
        // Assuming images are stored in the /img/ directory and are named based on dogName
        const imagePath = `/img/${dogName}.png`;
        
        // Set the src attribute of the image element
        dogImageElement.src = imagePath;
    });
</script> 